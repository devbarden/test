# ═══════════════════════════════════════════════════════════════════════════
#   Clerk — https://dashboard.clerk.com → API keys.
#   The webhook secret is optional: it enables POST /api/webhooks/clerk,
#   which erases a user's letters when their account is deleted.
# ═══════════════════════════════════════════════════════════════════════════
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
#   Generation API. The token is read by the server only and never reaches
#   the browser.
# ═══════════════════════════════════════════════════════════════════════════
GENERATION_API_URL=https://test-assignment-api.variant.net/v1/generate
GENERATION_API_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
#   Infrastructure. `npm run db:up` starts both locally with these URLs.
# ═══════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://alt_shift:alt_shift@localhost:5435/alt_shift
REDIS_URL=redis://localhost:6380

# ═══════════════════════════════════════════════════════════════════════════
#   Optional. CRON_SECRET (32+ characters) enables POST /api/cron/:job for
#   the scheduled purge; LOG_LEVEL is trace, debug, info, warn or error.
# ═══════════════════════════════════════════════════════════════════════════
CRON_SECRET=
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════
#   The public origin, e.g. https://altshift.app — no trailing slash. Read at
#   BUILD time (it is inlined into canonical links, hreflang, Open Graph,
#   the sitemap, robots.txt and llms.txt). Left empty, every page is served
#   noindex: a build that does not know its address must not be indexed.
# ═══════════════════════════════════════════════════════════════════════════
VITE_SITE_URL=
