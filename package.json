{
	"name": "alt-shift",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"predev": "npm run db:up && prisma migrate deploy",
		"dev": "vite dev --port 3000",
		"build": "prisma generate && vite build",
		"start": "SERVER_SHUTDOWN_TIMEOUT=95 node --enable-source-maps .output/server/index.mjs",
		"typecheck": "tsc --noEmit",
		"postinstall": "prisma generate",
		"db:up": "docker compose up -d --wait",
		"db:down": "docker compose down",
		"db:migrate": "prisma migrate dev",
		"db:migrate:create": "prisma migrate dev --create-only",
		"db:studio": "prisma studio",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@clerk/tanstack-react-start": "^1.0.8",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.103.2",
		"@tanstack/react-router": "1.170.15",
		"@tanstack/react-start": "1.168.25",
		"awilix": "^13.0.5",
		"clsx": "^2.1.1",
		"eventsource-parser": "^4.1.1",
		"ioredis": "^6.0.0",
		"lucide-react": "^0.545.0",
		"nitro": "^3.0.260903-beta",
		"pino": "^10.3.1",
		"rate-limiter-flexible": "^11.2.1",
		"react": "^19.3.0",
		"react-call": "^1.8.2",
		"react-dom": "^19.3.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@biomejs/biome": "2.4.16",
		"@rolldown/plugin-babel": "^0.2.4",
		"@types/node": "^22.19.19",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"prisma": "^7.10.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
