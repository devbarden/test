{
	"name": "alt-shift",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"predev": "npm run i18n:generate",
		"dev": "vite dev --port 3000",
		"prebuild": "npm run i18n:generate",
		"build": "prisma generate && vite build",
		"start": "node --enable-source-maps .output/server/index.mjs",
		"pretypecheck": "npm run i18n:generate",
		"typecheck": "tsc --noEmit",
		"pretest": "npm run i18n:generate",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"i18n:generate": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url cookie preferredLanguage baseLocale",
		"biome:lint": "biome check .",
		"biome:lint:fix": "biome check --write .",
		"e2e": "playwright test",
		"postinstall": "prisma generate",
		"db:up": "docker compose up -d --wait db redis",
		"db:down": "docker compose down",
		"db:migrate": "prisma migrate dev",
		"db:migrate:create": "prisma migrate dev --create-only",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"lint": "biome check .",
		"test:integration": "vitest run --project integration"
	},
	"dependencies": {
		"@clerk/localizations": "^4.17.1",
		"@clerk/tanstack-react-start": "^1.0.8",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@tanstack/query-sync-storage-persister": "^5.103.2",
		"@tanstack/react-query": "^5.103.2",
		"@tanstack/react-query-persist-client": "^5.103.2",
		"@tanstack/react-router": "1.170.15",
		"@tanstack/react-start": "1.168.25",
		"@tanstack/router-plugin": "1.168.18",
		"awilix": "^13.0.5",
		"clsx": "^2.1.1",
		"ioredis": "^6.0.0",
		"lucide-react": "^0.545.0",
		"nitro": "^3.0.260903-beta",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"rate-limiter-flexible": "^11.2.1",
		"react": "^19.3.0",
		"react-call": "^1.8.2",
		"react-dom": "^19.3.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@biomejs/biome": "2.4.16",
		"@clerk/testing": "^2.2.36",
		"@inlang/paraglide-js": "^2.25.4",
		"@playwright/test": "^1.63.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@testing-library/react": "^16.3.3",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^22.19.19",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"happy-dom": "^20.14.5",
		"prisma": "^7.10.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
