{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedKeys": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/package.json",
			"!**/package-lock.json",
			"!**/routeTree.gen.ts",
			"!public/fonts",
			"!src/generated"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["info", "warn", "error"]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/styles/base.css", "src/styles/view-transitions.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/**", "src/hooks/**", "src/lib/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/features/**",
											"@/screens/**",
											"@/routes/**",
											"@/domain/**",
											"@/backend/**"
										],
										"message": "Shared code knows no domain, feature, screen or backend. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/domain/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/backend/**",
											"@/features/**",
											"@/screens/**",
											"@/routes/**",
											"@/components/**",
											"@/hooks/**"
										],
										"message": "Domain code is pure: no React, no server, no UI. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/backend/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/features/**",
											"@/screens/**",
											"@/routes/**",
											"@/components/**",
											"@/hooks/**"
										],
										"message": "The backend knows no UI. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/applications/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/screens/**", "@/routes/**"],
										"message": "A feature never reaches up into a screen or a route. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/features/billing/**",
											"@/features/generation/**",
											"@/features/marketing/**"
										],
										"message": "Features are combined in the screen that needs them, not inside each other: take a callback instead."
									},
									{
										"group": ["@/backend/**", "!@/backend/middleware/**"],
										"message": "A feature reaches the server only through a server function and its middleware."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/billing/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/screens/**", "@/routes/**"],
										"message": "A feature never reaches up into a screen or a route. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/features/applications/**",
											"@/features/generation/**",
											"@/features/marketing/**"
										],
										"message": "Features are combined in the screen that needs them, not inside each other: take a callback instead."
									},
									{
										"group": ["@/backend/**", "!@/backend/middleware/**"],
										"message": "A feature reaches the server only through a server function and its middleware."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/generation/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/screens/**", "@/routes/**"],
										"message": "A feature never reaches up into a screen or a route. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/features/applications/**",
											"@/features/billing/**",
											"@/features/marketing/**"
										],
										"message": "Features are combined in the screen that needs them, not inside each other: take a callback instead."
									},
									{
										"group": ["@/backend/**", "!@/backend/middleware/**"],
										"message": "A feature reaches the server only through a server function and its middleware."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/marketing/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/screens/**", "@/routes/**"],
										"message": "A feature never reaches up into a screen or a route. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/features/applications/**",
											"@/features/billing/**",
											"@/features/generation/**"
										],
										"message": "Features are combined in the screen that needs them, not inside each other: take a callback instead."
									},
									{
										"group": ["@/backend/**", "!@/backend/middleware/**"],
										"message": "A feature reaches the server only through a server function and its middleware."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/application/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/routes/**", "@/backend/**"],
										"message": "A screen never imports a route or the backend. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/screens/auth/**",
											"@/screens/billing/**",
											"@/screens/dashboard/**",
											"@/screens/landing/**",
											"@/screens/workspace/**"
										],
										"message": "A screen never imports another screen: move the shared part into a feature or components."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/auth/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
