{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedKeys": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/package.json",
			"!**/package-lock.json",
			"!**/routeTree.gen.ts",
			"!public/fonts",
			"!src/generated"
		]
	},
	"formatter": {
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"complexity": {
				"noVoid": "error"
			},
			"recommended": true,
			"suspicious": {
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["info", "warn", "error"]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/styles/base.css", "src/styles/view-transitions.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["src/**/*.ts", "src/**/*.tsx", "!src/routes/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"filenameCases": ["kebab-case"],
								"requireAscii": true
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/domain/**", "src/features/**", "src/screens/**"],
			"linter": {
				"rules": {
					"performance": {
						"noBarrelFile": "error",
						"noReExportAll": "error"
					}
				}
			}
		},
		{
			"includes": ["src/components/**", "src/hooks/**", "src/lib/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/backend/**", "@/domain/**", "@/features/**", "@/routes/**", "@/screens/**"],
										"message": "Shared code knows no domain, feature, screen or backend (see Architecture in CLAUDE.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/domain/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/backend/**",
											"@/components/**",
											"@/features/**",
											"@/hooks/**",
											"@/routes/**",
											"@/screens/**"
										],
										"message": "Domain code is pure and imports nothing but lib/ (see Architecture in CLAUDE.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/backend/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/components/**", "@/features/**", "@/hooks/**", "@/routes/**", "@/screens/**"],
										"message": "The backend knows no UI: it imports only domain/ and lib/ (see Architecture in CLAUDE.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/routes/**", "@/screens/**"],
										"message": "A feature never reaches up into a screen or a route."
									},
									{
										"group": ["@/features/**"],
										"message": "A feature imports its own files relatively and never another feature: features are combined in the screen that needs them, so take a callback instead."
									},
									{
										"group": ["@/backend/**", "!@/backend/middleware/**"],
										"message": "A feature reaches the server only through a server function and its middleware."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/backend/**", "@/routes/**"],
										"message": "A screen never imports a route or the backend."
									},
									{
										"group": ["@/screens/**"],
										"message": "A screen imports its own files relatively and never another screen: move the shared part into a feature or components."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
