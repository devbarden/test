									{
										"group": ["@/routes/**", "@/backend/**"],
										"message": "A screen never imports a route or the backend. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/screens/application/**",
											"@/screens/billing/**",
											"@/screens/dashboard/**",
											"@/screens/landing/**",
											"@/screens/workspace/**"
										],
										"message": "A screen never imports another screen: move the shared part into a feature or components."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/billing/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/routes/**", "@/backend/**"],
										"message": "A screen never imports a route or the backend. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/screens/application/**",
											"@/screens/auth/**",
											"@/screens/dashboard/**",
											"@/screens/landing/**",
											"@/screens/workspace/**"
										],
										"message": "A screen never imports another screen: move the shared part into a feature or components."
									}
								]
							}
						}
					}
				}
			}
		},
