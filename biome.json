					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/routes/**", "@/backend/**"],
										"message": "A screen never imports a route or the backend. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/screens/application/**",
											"@/screens/auth/**",
											"@/screens/billing/**",
											"@/screens/landing/**",
											"@/screens/workspace/**"
										],
										"message": "A screen never imports another screen: move the shared part into a feature or components."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/landing/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/routes/**", "@/backend/**"],
										"message": "A screen never imports a route or the backend. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/screens/application/**",
											"@/screens/auth/**",
											"@/screens/billing/**",
											"@/screens/dashboard/**",
											"@/screens/workspace/**"
										],
										"message": "A screen never imports another screen: move the shared part into a feature or components."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/workspace/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/routes/**", "@/backend/**"],
										"message": "A screen never imports a route or the backend. Layers: routes → screens → features → domain · components · hooks · lib; backend → domain · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/screens/application/**",
											"@/screens/auth/**",
											"@/screens/billing/**",
											"@/screens/dashboard/**",
											"@/screens/landing/**"
										],
										"message": "A screen never imports another screen: move the shared part into a feature or components."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
