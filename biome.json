{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedKeys": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/package.json",
			"!**/package-lock.json",
			"!**/routeTree.gen.ts",
			"!public/fonts",
			"!src/generated",
			"!src/paraglide"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noJsxLiterals": "error"
			},
			"suspicious": {
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["info", "warn", "error"]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/styles/global.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/components/**",
				"src/hooks/**",
				"src/lib/**",
				"!**/*.server.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/features/**", "@/screens/**", "@/routes/**"],
										"message": "Shared code knows no feature, screen or route. Imports flow one way: routes → screens → features → components · hooks · lib (see CLAUDE.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/account/**", "!**/*.server.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/screens/**", "@/routes/**"],
										"message": "A feature never reaches up into a screen or a route. Imports flow one way: routes → screens → features → components · hooks · lib (see CLAUDE.md)."
									},
									{
										"group": [
											"@/features/applications/**",
											"@/features/billing/**",
											"@/features/generation/**",
											"@/features/marketing/**"
										],
										"message": "Features are combined in the screen that needs them, not inside each other: take a callback instead."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/applications/**", "!**/*.server.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
