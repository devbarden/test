{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedKeys": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/package.json",
			"!**/package-lock.json",
			"!**/routeTree.gen.ts",
			"!public/fonts",
			"!src/generated"
		]
	},
	"formatter": {
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"complexity": {
				"noVoid": "error"
			},
			"recommended": true,
			"suspicious": {
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["info", "warn", "error"]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/client/styles/base.css", "src/client/styles/view-transitions.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["src/**/*.ts", "src/**/*.tsx", "!src/routes/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"filenameCases": ["kebab-case"],
								"requireAscii": true
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/domain/**",
				"src/client/features/**",
				"src/client/screens/**",
				"!src/client/features/*/ui/*/index.ts",
				"!src/client/screens/*/*/index.ts",
				"!src/client/screens/*/*/*/index.ts"
			],
			"linter": {
				"rules": {
					"performance": {
						"noBarrelFile": "error",
						"noReExportAll": "error"
					}
				}
			}
		},
		{
			"includes": ["src/lib/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/server/**", "@/client/**", "@/domain/**", "@/routes/**"],
										"message": "lib/ is infrastructure for both sides: it knows no server, client or domain (see docs/architecture.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/domain/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/server/**", "@/client/**", "@/routes/**"],
										"message": "Domain code is pure and imports nothing but lib/ (see docs/architecture.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/server/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/client/**", "@/routes/**"],
										"message": "The server knows no UI: it imports only domain/ and lib/ (see docs/architecture.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/client/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/server/**", "!@/server/middleware/**"],
										"message": "Client code reaches the server only through a server function and its middleware."
									},
									{
										"group": ["**/*.server", "**/*.server.ts"],
										"message": "A .server module never enters the client bundle: import the middleware that wraps it."
									},
									{
										"group": ["@/routes/**"],
										"message": "Nothing imports a route: routes are entry points, not modules."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/client/components/**", "src/client/kit/**", "src/client/lib/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/server/**", "!@/server/middleware/**"],
										"message": "Client code reaches the server only through a server function and its middleware."
									},
									{
										"group": ["**/*.server", "**/*.server.ts"],
										"message": "A .server module never enters the client bundle: import the middleware that wraps it."
									},
									{
										"group": ["@/routes/**"],
										"message": "Nothing imports a route: routes are entry points, not modules."
									},
									{
										"group": ["@/domain/**", "@/client/features/**", "@/client/screens/**"],
										"message": "Shared client code knows no domain, feature or screen (see docs/architecture.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/client/features/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/server/**", "!@/server/middleware/**"],
										"message": "Client code reaches the server only through a server function and its middleware."
									},
									{
										"group": ["**/*.server", "**/*.server.ts"],
										"message": "A .server module never enters the client bundle: import the middleware that wraps it."
									},
									{
										"group": ["@/routes/**"],
										"message": "Nothing imports a route: routes are entry points, not modules."
									},
									{
										"group": ["@/client/screens/**"],
										"message": "A feature never reaches up into a screen."
									},
									{
										"group": ["@/client/features/**"],
										"message": "A feature imports its own files relatively and never another feature: features are combined in the screen that needs them, so take a callback instead."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/client/screens/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/server/**"],
										"message": "A screen never imports the server: it talks to it through a feature's server functions."
									},
									{
										"group": ["**/*.server", "**/*.server.ts"],
										"message": "A .server module never enters the client bundle: import the middleware that wraps it."
									},
									{
										"group": ["@/routes/**"],
										"message": "Nothing imports a route: routes are entry points, not modules."
									},
									{
										"group": ["@/client/screens/**"],
										"message": "A screen imports its own files relatively and never another screen: move the shared part into a feature or components."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
